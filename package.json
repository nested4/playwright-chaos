{
  "name": "playwright-chaos",
  "version": "0.1.1",
  "description": "Chaos engineering for Playwright E2E tests. Inject bad Wi-Fi, subway tunnels and Black Friday 503s into the tests you already have.",
  "keywords": [
    "playwright",
    "chaos-engineering",
    "e2e",
    "testing",
    "resilience",
    "qa",
    "network",
    "fault-injection"
  ],
  "license": "MIT",
  "author": "nested4 (https://github.com/nested4)",
  "homepage": "https://github.com/nested4/playwright-chaos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nested4/playwright-chaos.git"
  },
  "bugs": {
    "url": "https://github.com/nested4/playwright-chaos/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./reporter": {
      "import": {
        "types": "./dist/reporter.d.ts",
        "default": "./dist/reporter.js"
      },
      "require": {
        "types": "./dist/reporter.d.cts",
        "default": "./dist/reporter.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "demo": "node demo/server.mjs",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "chaos": "playwright test",
    "chaos:explore": "CHAOS_SEED=random playwright test",
    "prove:fragile": "node scripts/expect-failure.mjs fragile",
    "prove:naive-retry": "node scripts/expect-failure.mjs naive-retry",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
